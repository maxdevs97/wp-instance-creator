# DigitalOcean API Token
DO_API_TOKEN=your_digitalocean_api_token_here

# Form password (same as wp-data-entry-form)
FORM_PASSWORD=your_team_password_here

# SSH Private Key (for connecting to new droplets)
# Format: Base64 encoded or raw key with \n for newlines
SSH_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"
